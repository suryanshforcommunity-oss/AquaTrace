  "advisories": [
    {
      "id": "adv_001",
      "title": "Groundwater Drawdown Advisory: Enforcing Borewell Resting Cycles",
      "category": "drought_coping",
      "content": "Our Borewell #2 hydrostatic sensor indicates an 18.4m depth below casing (+0.3m drawdown this week). When borewells run continuously, the localized cone of depression deepens, causing motor cavitation and silt intake. All residents are urged to restrict non-essential washing between 2:00 PM and 5:00 PM when borewells undergo mandatory 90-minute resting cycles.",
      "author": "RWA Water Management Committee",
      "date": "16 Nov 2026",
      "readTime": "3 min read",
      "likes": 84,
      "isOfficial": true
    },
    {
      "id": "adv_002",
      "title": "Why Tap Aerators Cut Consumption by 45% Without Lowering Pressure",
      "category": "conservation_idea",
      "content": "Standard bathroom taps output 8 to 12 litres per minute. By replacing the tip with a mist or 3 LPM aerator, air is injected into the stream, maintaining identical tactile wash pressure while consuming less than half the water volume. RWA estate office has subsidized 3 LPM aerators available for Rs 60.",
      "author": "Vikram Sethi (Admin)",
      "date": "12 Nov 2026",
      "readTime": "2 min read",
      "likes": 126,
      "isOfficial": true
    },
    {
      "id": "adv_003",
      "title": "RWH Maintenance Protocol: Cleaning First-Flush Silt Traps",
      "category": "rwh_tips",
      "content": "The initial 15 minutes of any monsoon downpour carries atmospheric particulate and roof debris. If the first-flush diverter valve remains jammed shut, this silt bypasses filtration and chokes the gravel beds. Review the step-by-step checklist inside the RWH module before the upcoming November showers.",
      "author": "Ramesh Kumar (Lead Technician)",
      "date": "08 Nov 2026",
      "readTime": "4 min read",
      "likes": 92,
      "isOfficial": true
    },
    {
      "id": "adv_004",
      "title": "Detecting Silent Toilet Flapper Leaks with Food Coloring",
      "category": "leak_prevention",
      "content": "Add 4 drops of food color to your toilet cistern. Do not flush for 15 minutes. If color seeps into the bowl, your flush seal is leaking ~80-150 litres daily. Submit a quick photo report via our Leakage tab and the maintenance crew will replace the silicone seal within 24 hours.",
      "author": "Conservation Volunteer Team",
      "date": "02 Nov 2026",
      "readTime": "2 min read",
      "likes": 147,
      "isOfficial": false
    }
  ],
