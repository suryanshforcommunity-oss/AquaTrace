rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Community Water Intelligence & Telemetry Collections
    match /notifications/{id} {
      allow read, write: if true;
    }
    match /availability_logs/{id} {
      allow read, write: if true;
    }
    match /tanker_schedules/{id} {
      allow read, write: if true;
    }
    match /leakage_reports/{id} {
      allow read, write: if true;
    }
    match /groundwater_readings/{id} {
      allow read, write: if true;
    }
    match /water_saving_logs/{id} {
      allow read, write: if true;
    }
    match /water_quality_readings/{id} {
      allow read, write: if true;
    }
    match /forum_posts/{id} {
      allow read, write: if true;
    }
    match /society_storage/{id} {
      allow read, write: if true;
    }
    match /societies/{id} {
      allow read, write: if true;
    }

    // Default fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
